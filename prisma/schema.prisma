generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  collegeEmail         String    @unique
  usn                  String?   @default("")
  semester             Int       @default(1)
  teacherId            String?   @default("")
  coordinatorSemesters Int[]     @default([])
  classCoordinatorName String?   @default("")
  classCoordinatorId   String?
  classCoordinator     User?     @relation("ClassCoordinatorRelation", fields: [classCoordinatorId], references: [id], onDelete: SetNull)
  coordinatedStudents  User[]    @relation("ClassCoordinatorRelation")
  mentorName           String?   @default("")
  mentorId             String?
  mentor               User?     @relation("MentorRelation", fields: [mentorId], references: [id], onDelete: SetNull)
  mentoredStudents     User[]    @relation("MentorRelation")
  mentorAssignments    Json      @default("[]")
  password             String
  role                 String    @default("student")
  passwordResetToken   String?
  passwordResetExpires DateTime?
  nvidiaApiKey         String?   @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdSubjects     Subject[]     @relation("SubjectCreatedBy")
  createdMaterials    Material[]    @relation("MaterialCreatedBy")
  createdContentPosts ContentPost[] @relation("ContentPostCreatedBy")
  cieMarks            CieMark[]     @relation("StudentCieMarks")
  createdCieMarks     CieMark[]     @relation("CieMarkCreatedBy")
  attendanceRecords   Attendance[]  @relation("StudentAttendance")
  markedAttendance    Attendance[]  @relation("AttendanceMarkedBy")
  studySessions       StudySession[]

  @@index([role, semester])
  @@index([role, usn])
}

model Subject {
  id          String   @id @default(cuid())
  code        String
  name        String
  semester    Int
  credits     Int
  instructor  String?  @default("")
  description String?  @default("")
  createdById String?
  createdBy   User?    @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials Material[]
  cieMarks  CieMark[]
  attendanceRecords Attendance[]

  @@unique([code, semester])
}

model Material {
  id          String    @id @default(cuid())
  title       String
  category    String
  description String
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  semester    Int?
  link        String?   @default("")
  file        Json?
  dueDate     DateTime?
  createdById String?
  createdBy   User?     @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([semester, createdAt(sort: Desc)])
}

model ContentPost {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?  @default("")
  name        String?  @default("")
  roleTitle   String?  @default("")
  ctcLpa      String?  @default("")
  imageUrl    String?  @default("")
  image       Json?
  link        String?  @default("")
  createdById String?
  createdBy   User?    @relation("ContentPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model CieMark {
  id            String   @id @default(cuid())
  studentId     String?
  student       User?    @relation("StudentCieMarks", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester      Int
  cieNumber     Int
  marksObtained Float
  maxMarks      Float    @default(50)
  remarks       String?  @default("")
  createdById   String?
  createdBy     User?    @relation("CieMarkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectId, cieNumber])
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester   Int
  date       DateTime @db.Date
  status     String   @default("present")
  markedById String?
  markedBy   User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, subjectId, date])
  @@index([subjectId, date])
  @@index([studentId, semester])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New study session")
  subject   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages StudyMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model StudyMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
